# ---------------------------------------------------------------------------
# dma_songs environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# Only VITE_-prefixed variables are exposed to the browser. Never put the
# Supabase service-role key, database password or OAuth client secret here.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=https://dhbinzdohicmmnsnbemp.supabase.co

# Supabase publishable ("anon") key. Safe for the browser: it is only useful
# in combination with the Row Level Security policies in supabase/migrations.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bDHf3nXdB5PPKzVZE7vtWw_ZSK6yEqM



# Public site URL, used to build OAuth + password-reset redirect URLs.
# Local: http://localhost:5173   Production: https://your-app.vercel.app
VITE_SITE_URL=https://dma-songs.vercel.app/
